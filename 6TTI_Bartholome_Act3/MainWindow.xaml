<Window x:Class="_6TTI_Bartholome_Act3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6TTI_Bartholome_Act3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="Aquamarine">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2.5*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock TextWrapping="Wrap" Text="Exemple multipage" Grid.Column="0" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" >
            <Button Content="Page 1" x:Name="btnPage1" VerticalAlignment="Top" Height="41" FontWeight="Bold" FontSize="20" Background="LightYellow" />
            <Button Content="Page 2" x:Name="btnPage2" VerticalAlignment="Bottom" Height="41" FontWeight="Bold" FontSize="20" Background="LightBlue"/>
            <Button Content="Quitter" x:Name="btnQuitter" Grid.Column="1" VerticalAlignment="Center" Height="41" FontWeight="Bold" FontSize="20" Background="LightCoral"/>
        </StackPanel>
        <Frame x:Name="MainFrame" Grid.Row="1" Grid.ColumnSpan="2" NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
