<Window x:Class="_6TTI_Bartholome_Layout_Act1._2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6TTI_Bartholome_Layout_Act1._2"
        mc:Ignorable="d"
        Title="6TTI Bartholome Layout Act1.2" Height="450" Width="350
">
    <Grid Background="#FFB2B2B2">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="" Margin="5" Width="250" Foreground="{x:Null}" Background="White"/>
            <Button Content="C" Margin="10,5,5,5" Width="80" BorderBrush="Black" Background="Red" FontSize="45" FontWeight="Bold"/>  
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="1" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="2" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="3" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="+" Margin="0,5,5,5" Width="80" BorderBrush="Black" Background="Green" FontSize="45" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="4" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="5" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="6" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="-" Margin="0,5,5,5" Width="80" BorderBrush="Black" Background="Green" FontSize="45" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="7" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="8" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="9" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="/" Margin="0,5,5,5" Width="80" BorderBrush="Black" Background="Green" FontSize="45" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="," Margin="5" Width="80" BorderBrush="Black" Background="DeepSkyBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="0" Margin="5" Width="80" BorderBrush="Black" Background="CadetBlue" FontSize="45" FontWeight="Bold"/>
            <Button Content="*" Margin="5" Width="80" BorderBrush="Black" Background="Green" FontSize="45" FontWeight="Bold"/>
            <Button Content="=" Margin="0,5,5,5" Width="80" BorderBrush="Black" Background="Yellow" FontSize="45" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
