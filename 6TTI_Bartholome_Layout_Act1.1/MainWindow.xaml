<Window x:Class="_6TTI_Bartholome_Layout_Act1._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6TTI_Bartholome_Layout_Act1._1"
        mc:Ignorable="d"
        Title="6TTI_Bartholome_Layout_Act1.1" Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0" Background="#FFE9FF00">
            <Button Content="Bouton 1" Height="100" VerticalAlignment="Top"/>
            <Button Content="Bouton 2" Height="100" VerticalAlignment="Bottom"/>
        </StackPanel>
        <DockPanel Grid.Column="1" Grid.Row="0" Background="#FF00FF00">
            <Button Content="Top" DockPanel.Dock="Top" Height="40"/>
            <Button Content="Bottom" DockPanel.Dock="Bottom" Height="40"/>
            <Button Content="Left" DockPanel.Dock="Left" Width="40"/>
            <Button Content="Right" DockPanel.Dock="Right" Width="40"/>
            <Button Content="Direction"/>
        </DockPanel>
        <WrapPanel Grid.Column="0" Grid.Row="1" Background="#FFFF00E6" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Bouton 1" Width="95"/>
            <Button Content="Bouton 2" Width="95"/>
            <Button Content="Bouton 3" Width="95"/>
            <Button Content="Bouton 4" Width="95" Height="65"/>
            <Button Content="Bouton 5" Width="95"/>
            <Button Content="Bouton 6" Width="95"/>
        </WrapPanel>
        <Canvas Grid.Column="1" Grid.Row="1" Background="Coral">
            <Ellipse Canvas.Left="40" Canvas.Top="10" Width="150" Height="150" Fill="Black"/>
            <Ellipse Canvas.Left="62" Canvas.Top="32" Width="105" Height="105" Fill="#FFFFF000"/>
            <Ellipse Canvas.Left="85" Canvas.Top="55" Width="60" Height="60" Fill="Red"/>
        </Canvas>
    </Grid>
</Window>
